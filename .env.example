# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy fallback for the browser client.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Accepted server-key aliases: SUPABASE_SECRET_KEY, SUPABASE_SERVICE_KEY, SUPABASE_ROLE_KEY.

# Admin
ADMIN_ORDERS_TOKEN=

# Mercado Pago
PAYMENT_ENVIRONMENT=test
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
# Optional alias: MERCADOPAGO_WEBHOOK_SECRET
CRON_SECRET=
# Optional legacy access-token aliases: MERCADOPAGO_ACCESS_TOKEN, MP_ACCESS_TOKEN, MP_TOKEN.

# Public site origin
SITE_URL=
# Optional alias for SITE_URL.
NEXT_PUBLIC_SITE_URL=

# Order notifications (WhatsApp & E-mail)
# Webhook HTTPS público que recebe notificações de pedidos para disparo de WhatsApp (ex.: n8n, Make, Z-API, Evolution API)
WHATSAPP_ORDER_WEBHOOK_URL=
# Token Bearer opcional para autenticar as requisições enviadas ao webhook de WhatsApp
WHATSAPP_ORDER_WEBHOOK_TOKEN=
# Número de WhatsApp do dono da loja em formato internacional (ex.: 555499968814) para receber avisos imediatos de vendas aprovadas (evento: "order_paid_owner")
OWNER_NOTIFY_WHATSAPP=
# E-mail do dono da loja para receber cópia de reserva de confirmação de venda aprovada via Resend
OWNER_NOTIFY_EMAIL=
# Chave de API do Resend (iniciada com re_...) para envio de e-mails transacionais
RESEND_API_KEY=
# E-mail de remetente configurado e autenticado com domínio verificado no Resend (ex.: "Imports Alves <pedidos@importsalves.com.br>")
ORDER_EMAIL_FROM=

# Instagram Graph API (optional)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
